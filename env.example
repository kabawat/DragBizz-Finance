# Shared environment template for development and production.
# Dev/test: copy to .env. Production: copy to .env.production.
# Set environment mode, credentials and endpoints for the target server.

# ── Environment & Server ───────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=4002
SERVER_URL=http://dragbizz.local
HOSTNAME=.dragbizz.io
ALLOWED_ORIGINS=http://localhost:3000,https://test.dragbizz.com,https://dragbizz.io

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use the same MongoDB connection variable across environments
MONGODB_URI=
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=finance_user
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_PASSWORD=<copy-from-generated-service-env>
REDIS_DB=0

# ── Authentication / JWT (Must match auth service) ───────────────────────────
JWT_ISSUER=DragBizz-auth
ALGORITHM=RS256
AUDIENCE=DRAGBIZZ

# ── Active Payment Gateway (razorpay | stripe | cashfree | payu | easebuzz) ───
PAYMENT_GATEWAY=razorpay

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree (CASHFREE_ENV: sandbox | production)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=

# PayU (PAYU_ENV: sandbox | production)
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=sandbox
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=

# Easebuzz (EASEBUZZ_ENV: sandbox | production)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=sandbox
EASEBUZZ_SUCCESS_URL=
EASEBUZZ_FAILURE_URL=

# ── gRPC Configuration ────────────────────────────────────────────────────────
# Inbound Finance Payment gRPC Server
FINANCE_HOST=0.0.0.0
FINANCE_PORT=50056

# Outbound Core/Retailer gRPC Client
RETAILER_GRPC_HOST=localhost
RETAILER_GRPC_PORT=5001

# Outbound Utility gRPC Client
UTILITY_GRPC_HOST=localhost
UTILITY_GRPC_PORT=5003

# Production gRPC mTLS Paths (Optional for dev)
CORE_PAYMENT_GRPC_CA_PATH=
FINANCE_PAYMENT_GRPC_KEY_PATH=
FINANCE_PAYMENT_GRPC_CERT_PATH=

# ── Internal Service Security ─────────────────────────────────────────────────
ALLOWED_IPS=127.0.0.1,::1,localhost
INTERNAL_SERVICE_SECRET=

# ── Invoice Worker Configuration ──────────────────────────────────────────────
INVOICE_WORKER_BATCH_SIZE=5
INVOICE_WORKER_CONCURRENCY=3
INVOICE_WORKER_POLL_INTERVAL_MS=30000

# ── Docker Port Mappings ──────────────────────────────────────────────────────
HOST_HTTP_PORT=8002
HOST_GRPC_PORT=5002

# Additional runtime settings
CORS_ORIGIN=
NODE_ENV=development
