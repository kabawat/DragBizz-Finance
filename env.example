# Server
ENVIRONMENT=development
PORT=4002
SERVER_URL=http://localhost:4002
ALLOWED_ORIGINS=http://localhost:3000,https://test.dragbizz.com

# MongoDB (use MONGODB_URI for production, MONGODB_URI_DEV for development)
MONGODB_URI=
MONGODB_URI_DEV=mongodb://localhost:27017/dragbizz_subscription_dev
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (must match auth service)
JWT_ISSUER=DragBizz-auth
ALGORITHM=RS256
AUDIENCE=SUBSCRIPTION

# Razorpay (use test keys for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Other payment providers (optional)
STRIPE_SECRET=
CF_APP_ID=
CF_SECRET_KEY=

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# IP Whitelist
ALLOWED_IPS=127.0.0.1,::1,localhost,172.16.50.36,172.18.0.0/16,172.17.0.0/16
INTERNAL_SERVICE_SECRET=
