# Server
ENVIRONMENT=development
PORT=4002
SERVER_URL=http://localhost:4002
HOSTNAME=.dragbizz.io
CORS_ORIGIN=*
ALLOWED_ORIGINS=http://localhost:3000,https://test.dragbizz.com,https://dragbizz.io

# JWT audience must match auth access tokens (aud claim is DRAGBIZZ)
AUDIENCE=DRAGBIZZ

# MongoDB (use MONGODB_URI for production, MONGODB_URI_DEV for development)
MONGODB_URI=
MONGODB_URI_DEV=mongodb://localhost:27017/dragbizz_subscription_dev
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Redis (Docker: dev=redis-dev, prod/staging=redis or dragbizz_subscription-redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (must match auth service)
JWT_ISSUER=DragBizz-auth
ALGORITHM=RS256
AUDIENCE=SUBSCRIPTION

# Active gateway.  razorpay | stripe | cashfree | payu | easebuzz
PAYMENT_GATEWAY=razorpay

# Razorpay (use test keys for development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cashfree PG
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox # sandbox | production
CASHFREE_API_VERSION=2026-01-01
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=

# PayU
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=sandbox
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=

# Easebuzz
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=sandbox
EASEBUZZ_SUCCESS_URL=
EASEBUZZ_FAILURE_URL=

# Docker host port mappings
HOST_HTTP_PORT=8002

# Core gRPC client
RETAILER_GRPC_HOST=localhost
RETAILER_GRPC_PORT=5001

# IP Whitelist
ALLOWED_IPS=127.0.0.1,::1,localhost,172.16.50.36,172.18.0.0/16,172.17.0.0/16
INTERNAL_SERVICE_SECRET=
